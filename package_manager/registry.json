      "module_name": "settings",
      "path": "packages/settings",
      "enabled": true,
      "commands": [
        "/config",
        "/model",
        "/sandbox",
        "/network",
        "/heartbeat"
      ],
      "order": 1,
      "help": {
        "/config": "查看当前桥接配置",
        "/model": "查看 Codex 当前模型",
        "/sandbox [mode]": "查看或设置沙盒模式",
        "/network [on|off]": "查看或设置网络访问",
        "/heartbeat <分钟>": "设置心跳时间，0-30 分钟；0 为静默"
      },
      "usage": {
        "/config": "/config",
        "/model": "/model",
        "/sandbox": "/sandbox <read-only|workspace-write|danger-full-access>",
        "/network": "/network <on|off>",
        "/heartbeat": "/heartbeat <0-30>"
      }
    },
    {
      "id": "14ebf7e1797d4a44b3bac406d028c896",
      "name": "sessions",
      "module_name": "sessions",
      "path": "packages/sessions",
      "enabled": true,
      "commands": [
        "/session",
        "/resume",
        "/new",
        "/history",
        "/rename"
      ],
      "order": 2,
      "help": {
        "/session": "查看当前会话",
        "/resume <id|last>": "加载指定历史会话",
        "/new": "开始新会话",
        "/history [n]": "列出最近的 Codex 会话",
        "/rename <名称>": "重命名当前会话"
      },
      "usage": {
        "/session": "/session",
        "/resume": "/resume <会话ID|last>",
        "/new": "/new",
        "/history": "/history [数量]",
        "/rename": "/rename <新名称>"
      }
    },
    {
